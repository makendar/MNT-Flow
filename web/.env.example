# Copy to .env and adjust. Never commit real secrets.

# SQLite for local demo. For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma
# and use e.g. postgresql://user:password@localhost:5432/mntflow
DATABASE_URL="file:./dev.db"

# Session signing secret (32+ random characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Show one-click demo logins on /login. Always on in development; never enable on a public production host.
MNT_DEMO_LOGIN="false"

# AI provider. Only "mock" is implemented (deterministic, local, no data leaves the machine).
AI_PROVIDER="mock"
